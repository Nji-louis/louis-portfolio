# App
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
# Generate a random secret with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# PostgreSQL (managed PostgreSQL recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Admin login: ADMIN_PASSWORD_HASH is a bcrypt hash, never a plain password.
ADMIN_USERNAME=choose-a-private-username
# Generate with: node -e "require('bcryptjs').hash('YOUR_LONG_PASSWORD', 12).then(console.log)"
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Email notifications (SMTP credentials from your email provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Louis Portfolio <no-reply@example.com>
NOTIFY_EMAIL=you@example.com
# Optional acknowledgement to the person who submitted the form
SEND_LEAD_ACK=false

# Meta WhatsApp Cloud API: use a permanent/system-user token in production.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Destination admin number in international format, digits only e.g. 2376XXXXXXXX
WHATSAPP_NOTIFY_TO=
WHATSAPP_API_VERSION=v22.0
# Recommended: approved Meta template with 5 body text parameters: name, service, budget, timeline, lead ID
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
